  "siteOverrides": {},
  "extraSites": [],
  "disabledSites": [],
  "exemptRules": [],
  "exemptRulesBySite": {},
  "neverScan": [
    "*.bankofamerica.com",
    "*.chase.com",
    "*.wellsfargo.com",
    "*.adp.com",
    "*.paychex.com",
    "*.workday.com",
    "*.mychart.com",
    "*.irs.gov",
    "*.ssa.gov",
    "*.tylertech.com",
    "*.tylerhost.net",
    "*.county.gov"
