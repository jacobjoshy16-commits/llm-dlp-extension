{
  "_comment": [
    "AWS CLOUD FLEET BASELINE. Deployed via Microsoft Intune, GPO, or macOS",
    "Configuration Profiles to point Chrome/Edge extensions to the AWS Application",
    "Load Balancer (ALB) or API Gateway HTTPS endpoints.",
    "",
    "All local detection rules, ALWAYS_ENFORCE floor rules, conversation context,",
    "and file/paste inspection run identically on the local workstation."
  ],
  "endpoint": "https://dlp.county.gov/api/events",
